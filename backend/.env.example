# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/parknest

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect — hosts onboard via Connect so you can charge them the platform fee
# Platform fee: ParkNest takes 15% from the host payout on each booking
STRIPE_PLATFORM_FEE_PERCENT=15

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Analytics / User Flow ───────────────────────────────────────────────────
# All events are stored in the `analytics_events` DB table.
# Optional: pipe to PostHog, Mixpanel, or Segment by adding keys here.
# POSTHOG_API_KEY=phc_...
# SEGMENT_WRITE_KEY=...
